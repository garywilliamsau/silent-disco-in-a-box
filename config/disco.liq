#!/usr/bin/liquidsoap

# Silent Disco in a Box - Liquidsoap 2.x Configuration
# 3 channels with playlist sources
# ALSA line-in can be enabled later when USB audio adapters are connected

# Logging
log.file.set(true)
log.file.path.set("/var/log/liquidsoap/disco.log")
log.stdout.set(false)
log.level.set(3)

# Telnet server for remote control from Node.js
settings.server.telnet.set(true)
settings.server.telnet.bind_addr.set("127.0.0.1")
settings.server.telnet.port.set(1234)
settings.server.timeout.set(120.)  # prevent idle disconnect (default 30s)

# Audio settings
settings.frame.audio.samplerate.set(44100)
settings.frame.audio.channels.set(2)

# === LINE-IN AUDIO INPUTS (USB audio adapters) ===
# Card names are assigned by udev (/etc/udev/rules.d/99-linein.rules) based on
# USB port path, so they remain stable regardless of card number changes.
linein_red = input.external(
  id="linein_red",
  buffer=1.0,
  channels=1,
  samplerate=44100,
  restart_on_error=true,
  max=5.0,
  "/opt/disco/config/linein-capture.sh red"
)

linein_green = input.external(
  id="linein_green",
  buffer=1.0,
  channels=1,
  samplerate=44100,
  restart_on_error=true,
  max=5.0,
  "/opt/disco/config/linein-capture.sh green"
)

linein_blue = input.external(
  id="linein_blue",
  buffer=1.0,
  channels=1,
  samplerate=44100,
  restart_on_error=true,
  max=5.0,
  "/opt/disco/config/linein-capture.sh blue"
)

# Per-channel Line-In toggle
red_use_alsa = ref(false)
green_use_alsa = ref(false)
blue_use_alsa = ref(false)

# === BLUETOOTH AUDIO INPUT ===
# Captures from PulseAudio A2DP sink via bt-capture.sh
# Fallible source: unavailable when no BT device is streaming
bt_input = input.external(
  id="bt_input",
  buffer=2.0,
  channels=2,
  samplerate=44100,
  restart_on_error=true,
  max=10.0,
  "/opt/disco/config/bt-capture.sh"
)

# === SPOTIFY CONNECT INPUTS ===
# Each channel has its own raspotify instance outputting to a loopback subdevice
# Red=subdevice 1, Green=subdevice 2, Blue=subdevice 3
spotify_red = input.external(
  id="spotify_red",
  buffer=1.5,
  channels=2,
  samplerate=44100,
  restart_on_error=true,
  max=10.0,
  "/opt/disco/config/spotify-capture.sh 1"
)

spotify_green = input.external(
  id="spotify_green",
  buffer=1.5,
  channels=2,
  samplerate=44100,
  restart_on_error=true,
  max=10.0,
  "/opt/disco/config/spotify-capture.sh 2"
)

spotify_blue = input.external(
  id="spotify_blue",
  buffer=1.5,
  channels=2,
  samplerate=44100,
  restart_on_error=true,
  max=10.0,
  "/opt/disco/config/spotify-capture.sh 3"
)

# Keep Spotify inputs always consumed so the pipe to arecord never backs up.
# Without this: Liquidsoap buffer fills to max → pipe blocks → arecord stalls →
# ALSA loopback overflows → raspotify gets EPIPE → "Broken Pipe" / stutter.
# Liquidsoap 2.x caches frames for shared sources so dual-consumer is safe:
# each frame is pulled from input.external exactly once regardless of how many
# operators reference the source.
ignore(output.dummy(id="dummy_spotify_red",   fallible=true, spotify_red))
ignore(output.dummy(id="dummy_spotify_green", fallible=true, spotify_green))
ignore(output.dummy(id="dummy_spotify_blue",  fallible=true, spotify_blue))

# Per-channel Spotify toggle
red_use_spotify = ref(false)
green_use_spotify = ref(false)
blue_use_spotify = ref(false)


# === TALKOVER (voice broadcast over all channels) ===
# Reads raw S16LE mono 44100Hz PCM from a named pipe fed by the Node.js server
talkover_input = input.external(
  id="talkover",
  buffer=0.5,
  channels=1,
  samplerate=44100,
  restart_on_error=true,
  max=5.0,
  "/opt/disco/config/talkover-capture.sh"
)
talkover_stereo = audio_to_stereo(talkover_input)
talkover_safe = mksafe(talkover_stereo)

# Ducking: when talkover is active, music drops to 30% volume
talkover_active = ref(false)

server.register(
  namespace="talkover",
  description="Set talkover active state for ducking",
  usage="set_active true|false",
  "set_active",
  fun(v) -> begin
    talkover_active := (v == "true")
    "OK"
  end
)

def duck_volume()
  if talkover_active() then 0.3 else 1.0 end
end

# Per-channel Bluetooth toggle (mutually exclusive, managed by API)
red_use_bt = ref(false)
green_use_bt = ref(false)
blue_use_bt = ref(false)


# === PER-CHANNEL PIPELINE ===
# Red/Green/Blue used to be three near-identical ~130-line blocks. They are now
# generated by this single function to eliminate copy-paste drift between the
# channels (that drift is how the earlier channel-*.m3u path bug crept in — one
# block diverged from the others). Behaviour is equivalent to the old blocks.
#
# Source priority is preserved exactly per GOTCHAS.md: a SINGLE switch() with an
# always-true default case (queue -> playlist). This keeps the switch from ever
# being in a "no active source" state, which is what avoids the Liquidsoap 2.3
# generate_from_multiple_sources / Option.get(None) transition crash. Do NOT
# refactor this into per-mode switches wrapped in an outer fallback.
def make_channel(~id, ~name, ~description, ~mount, ~m3u,
                 ~use_alsa, ~use_bt, ~use_spotify, ~others_bt,
                 ~linein, ~spotify_in)
  # Set each toggle once up front. A ref whose first use is a read (`x()`) gets
  # inferred as a bare getter `() -> bool` and loses its `:=` setter; setting it
  # first pins the ref type. All toggles are false at load time, so this is a no-op.
  use_alsa := false
  use_bt := false
  use_spotify := false

  pl = playlist(
    id="#{id}_playlist",
    mode="normal",
    reload_mode="watch",
    m3u
  )
  pl = crossfade(duration=3., pl)

  queue = request.queue(id="#{id}_queue")
  queue_playlist = fallback(track_sensitive=false, transition_length=0., [queue, pl])

  chan_source = switch(
    track_sensitive=false,
    transition_length=0.,
    [
      (fun() -> use_alsa(),    mksafe(audio_to_stereo(linein))),
      (fun() -> use_bt(),      mksafe(bt_input)),
      (fun() -> use_spotify(), mksafe(spotify_in)),
      (fun() -> true,          queue_playlist)
    ]
  )
  safe = mksafe(chan_source)

  now_playing = ref([("artist",""), ("title",""), ("filename","")])

  safe.on_metadata(fun(m) -> begin
    now_playing := m
    # Push track metadata to the API (cheaper than the API polling us over telnet)
    ignore(http.post(
      "http://127.0.0.1:3000/api/channels/#{id}/liq-meta",
      headers=[("Content-Type", "application/json")],
      data=json.stringify({
        artist=list.assoc(default="", "artist", m),
        title=list.assoc(default="", "title", m),
        filename=list.assoc(default="", "filename", m)
      })
    ))
  end)

  server.register(
    namespace=id,
    description="Get now-playing metadata for #{id} channel",
    usage="now_playing",
    "now_playing",
    fun(_) -> begin
      m = now_playing()
      artist = list.assoc(default="", "artist", m)
      title = list.assoc(default="", "title", m)
      filename = list.assoc(default="", "filename", m)
      "artist=#{artist}\ntitle=#{title}\nfilename=#{filename}"
    end
  )

  server.register(
    namespace=id,
    description="Skip current track on #{id} channel",
    usage="skip",
    "skip",
    fun(_) -> begin
      source.skip(safe)
      "Skipped."
    end
  )

  server.register(
    namespace=id,
    description="Enable/disable Line-In on #{id} channel",
    usage="set_alsa true|false",
    "set_alsa",
    fun(v) -> begin
      use_alsa := (v == "true")
      "OK"
    end
  )

  server.register(
    namespace=id,
    description="Get Line-In status for #{id} channel",
    usage="get_alsa",
    "get_alsa",
    fun(_) -> if use_alsa() then "true" else "false" end
  )

  server.register(
    namespace=id,
    description="Enable/disable Bluetooth on #{id} channel",
    usage="set_bt true|false",
    "set_bt",
    fun(v) -> begin
      use_bt := (v == "true")
      if v == "true" then
        list.iter(fun(r) -> r := false, others_bt)
      end
      "OK"
    end
  )

  server.register(
    namespace=id,
    description="Get Bluetooth status for #{id} channel",
    usage="get_bt",
    "get_bt",
    fun(_) -> if use_bt() then "true" else "false" end
  )

  server.register(
    namespace=id,
    description="Enable/disable Spotify on #{id} channel",
    usage="set_spotify true|false",
    "set_spotify",
    fun(v) -> begin
      use_spotify := (v == "true")
      "OK"
    end
  )

  server.register(
    namespace=id,
    description="Get Spotify status for #{id} channel",
    usage="get_spotify",
    "get_spotify",
    fun(_) -> if use_spotify() then "true" else "false" end
  )

  chan_output = add(normalize=false, [amplify(duck_volume, safe), amplify(1.5, talkover_safe)])

  output.icecast(
    id="#{id}_icecast",
    %mp3(bitrate=128, samplerate=44100, stereo=true, id3v2=true),
    host="127.0.0.1",
    port=8000,
    password="hackme",
    mount=mount,
    name=name,
    description=description,
    public=false,
    fallible=false,
    chan_output
  )
end

# === CHANNEL: RED ===
make_channel(
  id="red", name="Red Channel", description="Silent Disco - Red", mount="/red",
  m3u="/home/pi/music/channel-red.m3u",
  use_alsa=red_use_alsa, use_bt=red_use_bt, use_spotify=red_use_spotify,
  others_bt=[green_use_bt, blue_use_bt],
  linein=linein_red, spotify_in=spotify_red
)

# === CHANNEL: GREEN ===
make_channel(
  id="green", name="Green Channel", description="Silent Disco - Green", mount="/green",
  m3u="/home/pi/music/channel-green.m3u",
  use_alsa=green_use_alsa, use_bt=green_use_bt, use_spotify=green_use_spotify,
  others_bt=[red_use_bt, blue_use_bt],
  linein=linein_green, spotify_in=spotify_green
)

# === CHANNEL: BLUE ===
make_channel(
  id="blue", name="Blue Channel", description="Silent Disco - Blue", mount="/blue",
  m3u="/home/pi/music/channel-blue.m3u",
  use_alsa=blue_use_alsa, use_bt=blue_use_bt, use_spotify=blue_use_spotify,
  others_bt=[red_use_bt, green_use_bt],
  linein=linein_blue, spotify_in=spotify_blue
)
